# Copy to `.env` for local overrides. Every setting is optional; the defaults in
# `vision_zero.config` are correct for a standard clone.
#
# Run `towards-vision-zero info` to see what actually resolved.

# Override only if the repository is not the project root — for example when the
# data lives on another volume.
# TVZ_PROJECT_ROOT=/path/to/towards-vision-zero

# Point at data held outside the repository.
# TVZ_DATA_DIR=/mnt/volume/saaq

# TVZ_RANDOM_SEED=42
# TVZ_LOG_LEVEL=INFO

# Set to false to downgrade missing or malformed input files from an error to a
# warning. Defaults to true: partial ingestion is invisible downstream.
# TVZ_STRICT_DATA=true
