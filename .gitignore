# ---------------------------------------------------------------------------
# Data.
#
# The raw SAAQ CSVs ARE committed: they are the citable source of record.
# Everything derived from them is not.
# ---------------------------------------------------------------------------
*.csv
!data/raw/saaq_201[1-9].csv
!data/raw/saaq_202[0-2].csv
# The test fixtures sit in `tests/fixtures/raw/`, so a single-level negation
# misses them and they never reach the repository. Every local run passes
# because they are on disk; a clean checkout has no fixtures and every
# integration test errors at setup.
!tests/fixtures/**/*.csv

data/processed/
data/interim/
*.parquet
!tests/fixtures/**/*.parquet

# Model artifacts and generated reports are reproducible from a config + seed.
artifacts/

# The explorer's payload IS committed, for the same reason `_freeze/` is: it is
# generated by `tvz export` from the compiled dataset, and the workflow that
# publishes the site checks out the repository without `data/` and so cannot
# regenerate it. Leaving it out produced a published page that loaded and then
# reported that it could not find its records.
#
# Regenerate with `uv run tvz export explorer_quebec` after any schema change,
# since the payload encodes the variable list and would otherwise serve a stale
# one.

# ---------------------------------------------------------------------------
# Quarto. `_freeze/` IS committed: it is what lets CI publish the site without
# executing Python or reading the data. Everything else here is build output.
# ---------------------------------------------------------------------------
/_book/
/_site/
/.quarto/

# Quarto writes its intermediate notebook as `chapter.quarto_ipynb_1`, with a
# numeric suffix, so a pattern without the trailing wildcard misses every one.
*.quarto_ipynb*

# Per-document output directories, written beside the source during a render
# and rebuilt on the next one.
*_files/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Notebooks: output is stripped by pre-commit, checkpoints are never wanted.
.ipynb_checkpoints/

# Local configuration. `.env.example` is committed; `.env` is not.
.env

# Editors and OS
.idea/
.vscode/
.DS_Store

# ---- Local working material ----
# Scratch space, drafts, and reference material kept alongside the project but
# deliberately outside version control. Contents vary by repo and are not
# reproducible from history -- they're covered by file-level backup instead.
excluded/

**/*.quarto_ipynb
