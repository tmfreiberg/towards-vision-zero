# ---------------------------------------------------------------------------
# Data.
#
# The raw SAAQ CSVs ARE committed: they are the citable source of record.
# Everything derived from them is not.
# ---------------------------------------------------------------------------
*.csv
!data/raw/saaq_201[1-9].csv
!data/raw/saaq_202[0-2].csv
!tests/fixtures/*.csv

data/processed/
data/interim/
*.parquet
!tests/fixtures/*.parquet

# Model artifacts and generated reports are reproducible from a config + seed.
artifacts/

# The explorer's payload is generated by `tvz export`; the page that reads it
# is committed, the records it reads are not.
app/records.bin.gz
app/meta.json

# ---------------------------------------------------------------------------
# Quarto. `_freeze/` IS committed: it is what lets CI publish the site without
# executing Python or reading the data. Everything else here is build output.
# ---------------------------------------------------------------------------
/_book/
/_site/
/.quarto/

# Quarto writes its intermediate notebook as `chapter.quarto_ipynb_1`, with a
# numeric suffix, so a pattern without the trailing wildcard misses every one.
*.quarto_ipynb*

# Per-document output directories, written beside the source during a render
# and rebuilt on the next one.
*_files/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Notebooks: output is stripped by pre-commit, checkpoints are never wanted.
.ipynb_checkpoints/

# Local configuration. `.env.example` is committed; `.env` is not.
.env

# Editors and OS
.idea/
.vscode/
.DS_Store
